  <script>
    // =======================================================
    // CẤU HÌNH SHOP — ĐỔI THÔNG TIN Ở ĐÂY LÀ ÁP DỤNG TOÀN WEB
    // =======================================================
    const SHOP = {
      name: 'sayo.oi',
      email: 'zhuy.unne88@gmail.com',
      facebook: 'https://www.facebook.com/zhuy.unne',
      messenger: 'https://m.me/zhuy.unne',
      instagram: 'https://www.instagram.com/sayo.oi/',
      instagramDM: 'https://ig.me/m/sayo.oi',
      instagramHandle: '@sayo.oi'
    };

    // Link "Ứng dụng web" của Google Apps Script (file Code.gs) — dán vào giữa 2 dấu nháy
    const GOOGLE_SCRIPT_URL = '';

    // Bảng giá — phải giống trong Code.gs
    const EXCHANGE_RATE = 21;
    const FEE_UNDER_1KG = 30000;
    const FEE_OVER_1KG = 60000;
    const SHIP_PER_KG = 180000;

    const STORAGE_PRODUCTS = 'sayooi_products_v1';
    const STORAGE_CART = 'sayooi_cart_v1';
    const STORAGE_ORDERS = 'sayooi_orders_v1';
    const DEFAULT_IMG = 'https://images.unsplash.com/photo-1556228720-195a672e8a03?auto=format&fit=crop&w=600&q=80';

    let currentProductsList = [];
    let productsLoaded = false;
    let isAdminLoggedIn = false;
    let adminPin = '';
    const API_READY = /^https:\/\/script\.google\.com\/macros\/s\/.+\/exec/.test(GOOGLE_SCRIPT_URL);
    let currentUploadedFile = null;
    let currentCatalogFilter = { type: 'all', value: '' };

    function escapeHtml(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }
    function applyShopConfig() {
      document.querySelectorAll('[data-shop]').forEach(el => {
        const k = el.getAttribute('data-shop');
        if (k === 'email') { el.href = 'mailto:' + SHOP.email; if (!el.textContent.trim()) el.textContent = SHOP.email; }
        else if (SHOP[k]) el.href = SHOP[k];
      });
      document.querySelectorAll('[data-shop-text="instagramHandle"]').forEach(el => el.textContent = SHOP.instagramHandle);
    }

    // =======================================================
    // 1. CÂN NẶNG & CÔNG THỨC GIÁ (GIỮ NGUYÊN NHƯ BẢN CŨ)
    // =======================================================
    function estimateSmartWeight(title, category, fallbackKg) {
      const t = (title || '').toLowerCase();
      const c = (category || '').toLowerCase();
      let actualKg = 0.25;

      if (t.includes('áo khoác') || t.includes('jacket') || t.includes('hoodie') || t.includes('padding') || t.includes('phao') || t.includes('windbreaker') ||
          t.includes('재킷') || t.includes('점퍼') || t.includes('패딩') || t.includes('코트') || t.includes('후드') || t.includes('트위드') || t.includes('베스트')) {
        actualKg = 0.85;
      } else if (t.includes('giày') || t.includes('sneaker') || t.includes('shoes') || c.includes('giày') || t.includes('samba') || t.includes('force') || t.includes('asics') ||
          t.includes('신발') || t.includes('스니커즈') || t.includes('운동화') || t.includes('러닝화')) {
        actualKg = 0.95;
      } else if (t.includes('mask') || t.includes('mặt nạ') || t.includes('마스크') || t.includes('pack') || t.includes('sheet') || t.includes('10+1') || t.includes('10매')) {
        actualKg = 0.35;
      } else if (t.includes('toner pad') || t.includes('토너패드') || t.includes('hộp to') || (t.includes('pad') && (t.includes('refill') || t.includes('리필') || t.includes('100매')))) {
        actualKg = 0.55;
      } else if (fallbackKg && Number(fallbackKg) > 0) {
        actualKg = Number(fallbackKg);
      }

      let billedKg = Math.ceil(actualKg * 2) / 2;
      if (billedKg < 0.5) billedKg = 0.5;
      return { actualWeight: actualKg, weight: billedKg, chargedKg: billedKg, billedKg: billedKg, displayLabel: billedKg.toFixed(1).replace('.0', '') + ' kg' };
    }

    // MỘT CÔNG THỨC DUY NHẤT cho thẻ sản phẩm, gửi ảnh và giỏ hàng (giống Code.gs):
    //   Giá về tay = Σ(giá KRW × 21) + Σ(công mua 30k/món <1kg, 60k/món ≥1kg) + (tổng kg làm tròn lên 0.5kg) × 180k
    function cleanKrw(v) { let k = parseInt(v, 10) || 0; if (k > 3000000) k = 25000; return Math.max(0, k); } // chống cào nhầm mã số thành giá
    function itemKg(weightClass, estKg) {
      return weightClass === 'over1' ? Math.max(1, Number(estKg) || 1) : Math.min(Math.max(Number(estKg) || 0.5, 0.1), 0.5);
    }
    function billKg(kg) { return kg > 0 ? Math.max(0.5, Math.ceil(kg * 2) / 2) : 0; }
    function kgLabel(kg) { return String(kg).replace('.', ',') + ' kg'; }

    function calculateOrderTotals(rows) {
      let krw = 0, fee = 0, kg = 0, pending = 0;
      rows.forEach(r => {
        const qty = Math.max(1, Number(r.qty) || 1);
        const price = cleanKrw(r.krw);
        if (price <= 0) { pending++; return; } // món chờ shop báo giá
        krw += price * qty;
        fee += (r.weightClass === 'over1' ? FEE_OVER_1KG : FEE_UNDER_1KG) * qty;
        kg += itemKg(r.weightClass, r.estKg) * qty;
      });
      const billedKg = billKg(kg);
      const converted = krw * EXCHANGE_RATE, ship = billedKg * SHIP_PER_KG;
      return { converted, fee, billedKg, ship, total: Math.round((converted + fee + ship) / 1000) * 1000, pending };
    }

    function calculateFormulaVND(krw, weightClass, estKg, oldKrw) {
      const now = calculateOrderTotals([{ krw, weightClass, estKg, qty: 1 }]);
      const oldK = cleanKrw(oldKrw);
      const old = oldK > cleanKrw(krw) ? calculateOrderTotals([{ krw: oldK, weightClass, estKg, qty: 1 }]).total : now.total;
      return {
        convertedVND: now.converted, buyingFee: now.fee, shipVND: now.ship,
        allInVND: now.total, oldAllInVND: old,
        weight: now.billedKg, chargedKg: now.billedKg, weightLabel: kgLabel(now.billedKg)
      };
    }

    function formatVND(num) { return Math.round(num || 0).toLocaleString('vi-VN') + ' đ'; }

    // =======================================================
    // 2. QUẢN TRỊ
    // =======================================================
    // Mã PIN được kiểm tra trên Google Apps Script — không nằm trong code web
    async function handleAdminAccess() {
      if (isAdminLoggedIn) { openAdminPanel(); return; }
      if (!API_READY) { alert('Chưa kết nối Google Sheets.\nHãy dán link Ứng dụng web (Code.gs) vào GOOGLE_SCRIPT_URL trong index.html.'); return; }
      const pin = prompt('Vui lòng nhập mã PIN quản trị viên:');
      if (pin === null || !pin.trim()) return;
      try {
        const res = await apiPost({ action: 'admin_login', pin: pin.trim() });
        if (res.status === 'success') {
          isAdminLoggedIn = true;
          adminPin = pin.trim();
          try { sessionStorage.setItem('sayooi_admin', adminPin); } catch (e) {}
          updateAdminStatusUI();
          openAdminPanel();
        } else {
          alert('Mã PIN không chính xác! Chỉ quản trị viên mới có quyền thao tác.');
        }
      } catch (e) {
        alert('Không kết nối được Google Sheets, thử lại sau nhé.');
      }
    }

    async function apiPost(body) {
      const res = await fetch(GOOGLE_SCRIPT_URL, { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body: JSON.stringify(body) });
      return res.json();
    }
    function handleAdminLoginClick() { handleAdminAccess(); }
    window.handleAdminAccess = handleAdminAccess;
    window.handleAdminLoginClick = handleAdminLoginClick;

    function updateAdminStatusUI() {
      const btn = document.getElementById('topBarAdminBtn');
      if (btn) btn.textContent = isAdminLoggedIn ? '● Vào quản trị' : 'Quản trị';
      const tools = document.getElementById('adminCatalogTools');
      if (tools) tools.classList.toggle('hidden', !isAdminLoggedIn);
      renderCatalogView();
      renderIntroTopProducts();
    }

    function updateAdminCount() {
      const countEl = document.getElementById('adminTotalCountText');
      if (countEl) countEl.textContent = `${currentProductsList.length} món`;
    }

    function openAdminPanel() {
      updateAdminCount();
      renderAdminManageList();
      switchPageView('admin');
      setTimeout(() => { const inp = document.getElementById('adminImportJsonInput'); if (inp) inp.focus(); }, 100);
    }

    function logoutAdmin() {
      isAdminLoggedIn = false;
      adminPin = '';
      try { sessionStorage.removeItem('sayooi_admin'); } catch (e) {}
      switchPageView('intro');
      updateAdminStatusUI();
      showToast('Đã đăng xuất quản trị', false);
    }

    let selectedProductIds = new Set();

    function renderAdminManageList() {
      const box = document.getElementById('adminProductManageList');
      if (!box) return;
      if (!currentProductsList || currentProductsList.length === 0) {
        box.innerHTML = '<div class="p-8 text-center text-mute text-[13px]">Kho hàng hiện đang trống.</div>';
        updateSelectedBadge();
        return;
      }
      box.innerHTML = currentProductsList.map((p) => {
        const isChecked = selectedProductIds.has(p.id) ? 'checked' : '';
        return `
          <div class="py-3 flex items-center justify-between gap-3 text-[13px] hover:bg-paper transition px-1">
            <div class="flex items-center gap-3 min-w-0">
              <input type="checkbox" class="w-4 h-4 accent-[#1c1a19] cursor-pointer" value="${p.id}" ${isChecked} onchange="toggleSelectProduct(${p.id}, this.checked)" />
              <img src="${escapeHtml(p.image || '')}" alt="" class="w-12 h-12 object-cover bg-paper shrink-0" onerror="this.onerror=null;this.src='${DEFAULT_IMG}'" />
              <div class="min-w-0">
                <div class="text-ink truncate">${escapeHtml(p.title)}</div>
                <div class="text-[11px] text-mute">${escapeHtml(p.brand || '')} · ${escapeHtml(p.mall || '')} · ${(p.krw || 0).toLocaleString()} ₩</div>
              </div>
            </div>
            <button type="button" onclick="deleteProductByAdmin(${p.id})" class="text-[12px] text-blush-700 hover:text-ink shrink-0">Xóa</button>
          </div>`;
      }).join('');
      updateSelectedBadge();
    }

    function toggleSelectProduct(id, isChecked) { if (isChecked) selectedProductIds.add(id); else selectedProductIds.delete(id); updateSelectedBadge(); }
    function selectAllAdminProducts(status) { if (status) currentProductsList.forEach(p => selectedProductIds.add(p.id)); else selectedProductIds.clear(); renderAdminManageList(); }
    function updateSelectedBadge() { const b = document.getElementById('selectedCountBadge'); if (b) b.textContent = selectedProductIds.size; }

    async function deleteSelectedProductsByAdmin() {
      if (!isAdminLoggedIn) { alert('Bạn không có quyền thực hiện thao tác này!'); return; }
      if (selectedProductIds.size === 0) { alert('Vui lòng tích chọn ít nhất 1 sản phẩm để xóa!'); return; }
      const count = selectedProductIds.size;
      if (!confirm(`Bạn có chắc chắn muốn xóa ${count} sản phẩm đã chọn khỏi website và Google Sheets?`)) return;
      currentProductsList = currentProductsList.filter(p => !selectedProductIds.has(p.id));
      selectedProductIds.clear();
      saveProductsToStorage(); renderAdminManageList(); renderCatalogView(); renderIntroTopProducts(); updateAdminCount();
      await uploadProductsToGoogleSheets();
      alert(`Đã xóa thành công ${count} sản phẩm!`);
    }

    async function deleteProductByAdmin(productId) {
      if (!isAdminLoggedIn) { alert('Bạn không có quyền thực hiện thao tác này!'); return; }
      const target = currentProductsList.find(p => p.id === productId);
      if (!target) return;
      if (confirm(`Bạn có chắc muốn xóa sản phẩm:\n"${target.title}"?`)) {
        currentProductsList = currentProductsList.filter(p => p.id !== productId);
        selectedProductIds.delete(productId);
        saveProductsToStorage(); renderAdminManageList(); renderCatalogView(); renderIntroTopProducts(); updateAdminCount();
        await uploadProductsToGoogleSheets();
        alert('Đã xóa món này thành công!');
      }
    }

    function getProductUniqueKey(item) {
      const link = item.link || '';
      const mOlive = link.match(/goodsNo=([A-Za-z0-9]+)/);
      if (mOlive) return 'OY_' + mOlive[1];
      const mKream = link.match(/products\/(\d+)/);
      if (mKream) return 'KREAM_' + mKream[1];
      return (item.title || '').toLowerCase().replace(/[^a-z0-9가-힣]/g, '');
    }

    function sanitizeProductDetails(item) {
      const wInfo = estimateSmartWeight(item.title, item.category, item.estKg);
      return Object.assign({}, item, {
        id: item.id || Date.now() + Math.floor(Math.random() * 1000),
        title: item.title || 'Sản phẩm Hàn Quốc',
        brand: item.brand || 'Olive Young',
        category: item.category || 'Mỹ phẩm',
        subCategory: item.subCategory || 'Skincare',
        mall: item.mall || 'Olive Young',
        krw: Number(item.krw) || 20000,
        oldKrw: Number(item.oldKrw) || 0,
        weightClass: wInfo.billedKg >= 1.0 ? 'over1' : 'under1',
        estKg: wInfo.billedKg,
        isSale: item.isSale === true || String(item.isSale).toLowerCase() === 'true' || (Number(item.oldKrw) > Number(item.krw) && Number(item.krw) > 0),
        salesCount: item.salesCount || 0,
        variant: item.variant || 'Chính hãng từ Hàn Quốc',
        link: item.link || '',
        image: item.image || DEFAULT_IMG,
        benefit: item.benefit || 'Hàng chính hãng nội địa Hàn Quốc.',
        benefits: item.benefits || ['Sản phẩm nội địa Hàn Quốc chính hãng từ Olive Young/KREAM.'],
        targetAudience: item.targetAudience || 'Mọi loại da, phù hợp với thị hiếu người dùng châu Á.',
        usageGuide: item.usageGuide || 'Sử dụng đều đặn theo hướng dẫn của nhà sản xuất.'
      });
    }

    async function handleAdminImportSubmit() {
      const inputEl = document.getElementById('adminImportJsonInput');
      const importBtn = document.getElementById('adminImportBtn');
      if (!inputEl) return;
      let raw = inputEl.value.trim();
      if (!raw) { alert('Vui lòng dán mã từ Bookmarklet vào ô!'); return; }

      raw = raw.replace(/[\u0000-\u001F\u007F-\u009F]/g, '');
      const firstBracket = raw.indexOf('['), lastBracket = raw.lastIndexOf(']');
      if (firstBracket !== -1 && lastBracket !== -1 && lastBracket > firstBracket) raw = raw.substring(firstBracket, lastBracket + 1);
      else if (raw.startsWith('{') && raw.endsWith('}')) raw = '[' + raw + ']';

      let list = null;
      try { list = JSON.parse(raw); } catch (err) { alert('Dữ liệu JSON dán vào không hợp lệ. Hãy kiểm tra lại!'); return; }

      if (Array.isArray(list) && list.length > 0) {
        if (importBtn) { importBtn.disabled = true; importBtn.textContent = 'Đang lọc trùng & đồng bộ…'; }
        const combined = list.map(sanitizeProductDetails).concat(currentProductsList);
        const seen = {}, unique = [];
        combined.forEach(prod => { const k = getProductUniqueKey(prod); if (!seen[k]) { seen[k] = true; unique.push(prod); } });
        const duplicateCount = combined.length - unique.length;
        currentProductsList = unique;
        saveProductsToStorage();
        await uploadProductsToGoogleSheets();
        inputEl.value = '';
        renderAdminManageList(); renderCatalogView(); renderIntroTopProducts(); updateAdminCount();
        if (importBtn) { importBtn.disabled = false; importBtn.textContent = 'Nạp lên web & đồng bộ Google Sheets'; }
        alert(`Đã nạp thành công!\n• Tổng sản phẩm hiện có: ${currentProductsList.length} món.\n• Đã tự động loại bỏ: ${duplicateCount} món bị trùng lặp.`);
      } else {
        alert('Dữ liệu JSON không đúng danh sách sản phẩm!');
      }
    }

