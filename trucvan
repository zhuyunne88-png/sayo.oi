    function extractKrwPrice(text) {
      const t = text.replace(/[Oo](?=\d{2})/g, '0');
      const found = [];
      const re = /(?:₩|\\|W)\s?(\d{1,3}(?:[,.]\d{3})+|\d{4,7})|(\d{1,3}(?:[,.]\d{3})+|\d{4,7})\s?(?:원|won|KRW)/gi;
      let m;
      while ((m = re.exec(t))) {
        const v = parseInt(String(m[1] || m[2]).replace(/[,.]/g, ''), 10);
        if (v >= 1000 && v <= 3000000) found.push(v);
      }
      if (!found.length) return 0;
      return Math.min.apply(null, found); // trang Hàn thường hiện giá gốc + giá sale → lấy giá thấp hơn
    }

    function scoreProductMatch(p, textLow) {
      let score = 0;
      const brand = (p.brand || '').toLowerCase();
      if (brand && brand.length > 2 && textLow.includes(brand)) score += 5;
      (p.title || '').toLowerCase().split(/[\s,()\/\-\[\]]+/).filter(w => w.length >= 3).forEach(w => { if (textLow.includes(w)) score += 1; });
      return score;
    }

