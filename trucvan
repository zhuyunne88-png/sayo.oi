    }

    // =======================================================
    // 12. HIỆU ỨNG HERO: CÁNH HOA, TIM, CHẤM BAY NHẸ
    // =======================================================
    function buildPetals() {
      const layer = document.getElementById('petalLayer');
      if (!layer) return;
      const flower = (c) => `<svg viewBox="0 0 24 24" width="100%" height="100%"><g fill="${c}">${[0, 72, 144, 216, 288].map(a => `<ellipse cx="12" cy="6.2" rx="3.6" ry="5.2" transform="rotate(${a} 12 12)"/>`).join('')}</g><circle cx="12" cy="12" r="2" fill="#fff" opacity=".8"/></svg>`;
      const heart = (c) => `<svg viewBox="0 0 24 24" width="100%" height="100%"><path d="M12 20s-7-4.4-7-9.6A3.9 3.9 0 0 1 12 8a3.9 3.9 0 0 1 7 2.4C19 15.6 12 20 12 20z" fill="none" stroke="${c}" stroke-width="1.4"/></svg>`;
      const dot = (c) => `<svg viewBox="0 0 10 10" width="100%" height="100%"><circle cx="5" cy="5" r="5" fill="${c}"/></svg>`;
      const ring = (c) => `<svg viewBox="0 0 24 24" width="100%" height="100%"><path d="M4 15c3 4 13 4 16-3" fill="none" stroke="${c}" stroke-width="2.2" stroke-linecap="round"/><path d="M17 9l3 3-4 1" fill="none" stroke="${c}" stroke-width="2.2" stroke-linecap="round"/></svg>`;
      const kinds = [
        { f: flower, c: '#f3c6cf', s: [14, 22], o: [.55, .85], n: 6 },
        { f: flower, c: '#e9d3d6', s: [10, 16], o: [.5, .8], n: 3 },
        { f: heart, c: '#d9d2d2', s: [14, 22], o: [.6, .9], n: 9 },
        { f: dot, c: '#bdb6b6', s: [3, 6], o: [.35, .7], n: 26 },
        { f: ring, c: '#f6dd9a', s: [26, 36], o: [.6, .8], n: 1 }
      ];
      const W = layer.clientWidth || 1200, H = layer.clientHeight || 500;
      const rand = (a, b) => a + Math.random() * (b - a);
      let html = '';
      kinds.forEach(k => {
        for (let i = 0; i < k.n; i++) {
          let x, y;
          do { x = rand(2, 98); y = rand(4, 96); } while (x > 32 && x < 68 && y > 22 && y < 78 && k.f !== dot); // chừa khoảng giữa cho chữ
          const size = rand(k.s[0], k.s[1]);
          const o = rand(k.o[0], k.o[1]);
          const dur = rand(14, 26), delay = -rand(0, 20);
          const style = `left:${x}%;top:${y}%;width:${size}px;height:${size}px;opacity:${o};--o:${o};--dx:${rand(6, 18).toFixed(1)}px;--dy:${rand(6, 16).toFixed(1)}px;--rot:${rand(-40, 40).toFixed(0)}deg;animation:drift ${dur.toFixed(1)}s ease-in-out ${delay.toFixed(1)}s infinite${k.f === dot ? `, twinkle ${rand(3, 7).toFixed(1)}s ease-in-out ${delay.toFixed(1)}s infinite` : ''};`;
          html += `<span class="petal" data-depth="${(size / 40).toFixed(2)}" style="${style}">${k.f(k.c)}</span>`;
        }
      });
      layer.innerHTML = html;

      // nghiêng nhẹ theo chuột
      const frame = document.getElementById('heroFrame');
      if (frame && window.matchMedia('(hover: hover)').matches) {
        frame.addEventListener('mousemove', ev => {
          const r = frame.getBoundingClientRect();
          const mx = (ev.clientX - r.left) / r.width - .5, my = (ev.clientY - r.top) / r.height - .5;
          layer.style.transform = `translate3d(${(-mx * 14).toFixed(1)}px, ${(-my * 10).toFixed(1)}px, 0)`;
        });
        frame.addEventListener('mouseleave', () => { layer.style.transform = ''; });
        layer.style.transition = 'transform .8s cubic-bezier(.16,1,.3,1)';
      }
    }

    // =======================================================
    // 13. KHỞI CHẠY
    // =======================================================
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') { closeProductDetailModal(); toggleSearchBar(false); toggleMobileMenu(false); }
    });

    window.addEventListener('DOMContentLoaded', () => {
      applyShopConfig();
      buildPetals();
      renderCatalogView();
      renderIntroTopProducts();
      renderOrderRows();
      recalculateLensVND();
      setJourneyStage(1);
      startAutoJourney();
      syncProductsFromGoogleSheets();
      restoreAdminSession();
    });
  </script>
</body>
</html>
