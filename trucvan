        { r: /바이오힐보/gi, v: 'Bioheal BOH' }, { r: /달바/gi, v: "d'Alba" }, { r: /에스트라/gi, v: 'Aestura' },
        { r: /일리윤/gi, v: 'Illiyoon' }, { r: /토니모리/gi, v: 'Tonymoly' }, { r: /오리온/gi, v: 'Orion' },
