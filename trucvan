    function getFilteredProductsList() {
      if (!Array.isArray(currentProductsList) || currentProductsList.length === 0) return [];
      if (!currentCatalogFilter || currentCatalogFilter.type === 'all') return currentProductsList;
      const { type, value } = currentCatalogFilter;
      const rawVal = (value || '').trim().toLowerCase();
      const cleanVal = rawVal.replace(/[\.\-\_\s]+/g, '');
      const clean = s => (s || '').toLowerCase().replace(/[\.\-\_\s]+/g, '');

      if (type === 'search') return currentProductsList.filter(p => clean(`${p.title} ${p.brand} ${p.category} ${p.mall}`).includes(cleanVal));
      if (type === 'brand') return currentProductsList.filter(p => clean(p.brand).includes(cleanVal));
      if (type === 'mall') return currentProductsList.filter(p => (p.mall || '').toLowerCase() === rawVal);
      if (type === 'category') return currentProductsList.filter(p => (p.category || '').toLowerCase() === rawVal);
      if (type === 'subCategory') return currentProductsList.filter(p => clean(`${p.subCategory} ${p.title}`).includes(cleanVal));
      if (type === 'sale') return currentProductsList.filter(p => p.isSale);
      return currentProductsList;
    }

