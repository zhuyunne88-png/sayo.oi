      ];

      async function translateFallback(text) {
        try {
          const res = await fetch(`https://translate.googleapis.com/translate_a/single?client=gtx&sl=ko&tl=vi&dt=t&q=${encodeURIComponent(text)}`);
          const data = await res.json();
          let out = '';
          if (data && data[0]) data[0].forEach(item => { if (item[0]) out += item[0]; });
          return out || text;
