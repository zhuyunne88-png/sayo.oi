  <style>
    :root { --ink:#1c1a19; --mute:#9b9490; --line:#ebe6e3; --blush:#e8b4bd; --rose:#a35d6a; }
    html { scroll-behavior: smooth; overflow-x: hidden; }
    body {
      font-family: 'Be Vietnam Pro', system-ui, sans-serif;
      font-weight: 300;
      background: #ffffff;
      color: var(--ink);
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }
    .font-serif, h1, h2, h3, .serif { font-family: 'Cormorant Garamond', Georgia, serif; }
    ::selection { background: #f1d2d8; color: #1c1a19; }

    /* ===== HEADER ===== */
    .nav-link {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 19px; font-weight: 400; color: #5f5a57;
      position: relative; padding: 6px 0; cursor: pointer; transition: color .2s ease;
      background: none; border: 0;
    }
    .nav-link:hover, .nav-link.active-nav { color: var(--ink); }
    .nav-link::after {
      content: ''; position: absolute; left: 0; right: 100%; bottom: 0; height: 1px;
      background: var(--ink); transition: right .3s ease;
    }
    .nav-link:hover::after, .nav-link.active-nav::after { right: 0; }
    .dropdown { opacity: 0; visibility: hidden; transform: translateY(6px); transition: all .25s cubic-bezier(.16,1,.3,1); }
    .dropdown-parent:hover .dropdown, .dropdown-parent:focus-within .dropdown { opacity: 1; visibility: visible; transform: translateY(0); }
    .dropdown-parent.force-close .dropdown { opacity: 0 !important; visibility: hidden !important; }
    .dd-item {
      display: flex; justify-content: space-between; align-items: baseline; width: 100%;
      text-align: left; padding: 7px 0; font-size: 13px; color: #5f5a57; cursor: pointer;
      background: none; border: 0; transition: color .15s ease, padding .2s ease;
    }
    .dd-item:hover { color: var(--ink); padding-left: 4px; }
    .dd-item small { font-size: 11px; color: var(--mute); }
    .logo-word { font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic; font-weight: 400; letter-spacing: .01em; }

    /* ===== HERO ===== */
    .hero-frame {
      background:
        radial-gradient(ellipse 60% 70% at 50% 45%, #ffffff 0%, rgba(255,255,255,0) 70%),
        radial-gradient(ellipse 90% 90% at 50% 50%, #fbf5f6 0%, #faf7f7 55%, #ffffff 100%);
    }
    .hero-title { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 300; letter-spacing: .005em; line-height: 1; }
    .petal { position: absolute; pointer-events: none; will-change: transform; }
    @keyframes drift {
      0%   { transform: translate3d(0,0,0) rotate(0deg); }
      25%  { transform: translate3d(var(--dx), calc(var(--dy) * -1), 0) rotate(calc(var(--rot) * .5)); }
      50%  { transform: translate3d(calc(var(--dx) * -.4), var(--dy), 0) rotate(var(--rot)); }
      75%  { transform: translate3d(calc(var(--dx) * -1), calc(var(--dy) * -.4), 0) rotate(calc(var(--rot) * .3)); }
      100% { transform: translate3d(0,0,0) rotate(0deg); }
    }
    @keyframes twinkle { 0%,100% { opacity: var(--o); } 50% { opacity: calc(var(--o) * .35); } }
    .fade-up { opacity: 0; transform: translateY(10px); animation: fadeUp 1.1s cubic-bezier(.16,1,.3,1) forwards; }
    .fade-up.d1 { animation-delay: .15s; } .fade-up.d2 { animation-delay: .35s; } .fade-up.d3 { animation-delay: .6s; }
    @keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }
    @media (prefers-reduced-motion: reduce) { .petal, .fade-up { animation: none !important; opacity: 1; transform: none; } }

    /* ===== COMMON ===== */
    .page-view { display: none; }
    .page-view.active-view { display: block; animation: fadeInView .35s ease-out; }
    @keyframes fadeInView { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
    .eyebrow { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--mute); font-weight: 400; }
    .section-title { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 300; color: var(--ink); line-height: 1.1; }
    .btn-ink {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      background: var(--ink); color: #fff; border: 1px solid var(--ink);
      font-size: 12px; letter-spacing: .14em; text-transform: uppercase; font-weight: 400;
      padding: 13px 26px; transition: all .25s ease; cursor: pointer;
    }
    .btn-ink:hover { background: #fff; color: var(--ink); }
    .btn-ink:disabled { opacity: .55; cursor: wait; }
    .btn-line {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      background: transparent; color: var(--ink); border: 1px solid var(--ink);
      font-size: 12px; letter-spacing: .14em; text-transform: uppercase; font-weight: 400;
      padding: 13px 26px; transition: all .25s ease; cursor: pointer;
    }
    .btn-line:hover { background: var(--ink); color: #fff; }
    .btn-text { font-size: 13px; color: var(--soft, #5f5a57); border-bottom: 1px solid currentColor; padding-bottom: 1px; cursor: pointer; transition: color .2s; background: none; }
    .btn-text:hover { color: var(--ink); }
    .field {
      width: 100%; background: #fff; border: 0; border-bottom: 1px solid #d9d3cf;
      padding: 10px 0; font-size: 14px; color: var(--ink); outline: none; border-radius: 0;
      transition: border-color .2s ease; font-weight: 400;
    }
    .field:focus { border-bottom-color: var(--ink); }
    .field::placeholder { color: #bdb6b2; font-weight: 300; }
    .field-box {
      width: 100%; background: #fff; border: 1px solid #e3ddd9; padding: 10px 12px;
      font-size: 13px; color: var(--ink); outline: none; transition: border-color .2s ease; font-weight: 400;
    }
    .field-box:focus { border-color: var(--ink); }
    .label { display: block; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--mute); margin-bottom: 4px; }
    .card-surface { background: #fff; border: 1px solid var(--line); }
    .chip {
      padding: 7px 16px; font-size: 12px; letter-spacing: .06em; border: 1px solid var(--line);
      color: #5f5a57; background: #fff; white-space: nowrap; cursor: pointer; transition: all .2s ease;
    }
    .chip:hover { border-color: #b9b1ad; color: var(--ink); }
    .chip.is-active { background: var(--ink); border-color: var(--ink); color: #fff; }
    .price { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 500; }
    .custom-scrollbar::-webkit-scrollbar { width: 5px; height: 5px; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #e2d6d8; border-radius: 9999px; }
    .force-clickable { pointer-events: auto !important; cursor: pointer !important; }
    .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

    /* product card */
    .p-card .p-img { aspect-ratio: 1 / 1; background: #f7f3f2; overflow: hidden; position: relative; }
    .p-card .p-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .9s cubic-bezier(.16,1,.3,1); }
    .p-card:hover .p-img img { transform: scale(1.045); }
    .p-card .p-quick {
      position: absolute; left: 10px; right: 10px; bottom: 10px; opacity: 0; transform: translateY(8px);
      transition: all .35s cubic-bezier(.16,1,.3,1);
    }
    .p-card:hover .p-quick { opacity: 1; transform: none; }
    @media (hover: none) { .p-card .p-quick { display: none; } }

    /* lens laser */
    .lens-laser-line {
      position: absolute; left: 0; right: 0; height: 2px;
      background: linear-gradient(90deg, transparent, #e8b4bd, #ffffff, #e8b4bd, transparent);
      box-shadow: 0 0 14px 3px rgba(232, 180, 189, .8);
      animation: scanLaser 1.8s ease-in-out infinite;
    }
    @keyframes scanLaser { 0% { top: 4%; } 50% { top: 92%; } 100% { top: 4%; } }

    /* journey */
    .journey-btn { border-left: 1px solid var(--line); }
    .journey-btn.is-active { border-left-color: var(--ink); }
    .journey-btn.is-active .j-num { color: var(--ink); }
    .journey-btn.is-active .j-title { color: var(--ink); }
    @keyframes floatSoft { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
    .float-soft { animation: floatSoft 3.8s ease-in-out infinite; }

    /* toast */
    #toast { transition: all .35s cubic-bezier(.16,1,.3,1); }
    #toast.show { opacity: 1; transform: translate(-50%, 0); pointer-events: auto; }

    /* track timeline */
    .tl-dot { width: 9px; height: 9px; border-radius: 9999px; border: 1px solid #cfc7c3; background: #fff; }
    .tl-step.done .tl-dot { background: var(--ink); border-color: var(--ink); }
    .tl-step.current .tl-dot { background: var(--blush); border-color: var(--rose); box-shadow: 0 0 0 4px #f9e9ec; }
  </style>
</head>
