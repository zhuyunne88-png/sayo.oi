    function extractSalesPopularity(item) {
      let score = 500;
      const str = ((item.title || '') + ' ' + (item.brand || '') + ' ' + (item.mall || '')).toLowerCase();
      if (str.includes('olive') || str.includes('mediheal') || str.includes('laneige') || str.includes('medicube') || str.includes('torriden')) score += 20000;
      if (item.salesCount && Number(item.salesCount) > 0) return score + Number(item.salesCount);
      const m = str.match(/(?:giao dịch|deal|ưu đãi|거래)\s*([0-9.,]+)\s*([만kmn万]?)/i);
      if (m) {
        const val = parseFloat(m[1].replace(/,/g, '.'));
        const unit = (m[2] || '').toLowerCase();
        if (unit === '만' || unit === 'vạn' || unit === 'm' || str.includes('만') || str.includes('.000')) score += val >= 100 ? Math.round(val * 1000) : Math.round(val * 10000);
        else score += Math.round(val * 1000);
      }
      return score;
    }

