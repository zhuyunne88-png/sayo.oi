    async function runImageScan(dataUrl) {
      const overlay = document.getElementById('lensLaserOverlay');
      if (overlay) { overlay.classList.remove('hidden'); overlay.classList.add('flex'); }
      const fName = document.getElementById('lensDetectedName'), fBrand = document.getElementById('lensDetectedBrand');
      const fPrice = document.getElementById('lensPriceKRW'), fVar = document.getElementById('lensDetectedBenefit');
      fName.value = ''; fBrand.value = ''; fVar.value = ''; fPrice.value = '';
      setLensStatus('');
      document.getElementById('lensSuggestedMatchesBox').classList.add('hidden');

      let text = '';
      try {
        if (window.Tesseract) {
          const job = Tesseract.recognize(dataUrl, 'kor+eng');
          const timeout = new Promise((_, rej) => setTimeout(() => rej(new Error('timeout')), 45000));
          const r = await Promise.race([job, timeout]);
          text = (r && r.data && r.data.text) || '';
        }
      } catch (e) { console.warn('OCR lỗi:', e); }

      const low = text.toLowerCase();
      const price = extractKrwPrice(text);
      const sig = BRAND_SIGNATURES.find(b => b.key.test(text));

      // Gợi ý sản phẩm trong kho khớp với chữ trên ảnh
      const matches = low ? currentProductsList.map(p => ({ p, sc: scoreProductMatch(p, low) })).filter(x => x.sc >= 5).sort((a, b) => b.sc - a.sc).slice(0, 3) : [];
      if (matches.length) {
        const box = document.getElementById('lensSuggestedMatchesBox');
        document.getElementById('lensSuggestedMatchesList').innerHTML = matches.map(({ p }) => `
          <button type="button" onclick="useLensMatch(${p.id})" class="w-full flex items-center gap-3 text-left hover:bg-paper p-1.5 transition">
            <img src="${escapeHtml(p.image)}" class="w-11 h-11 object-cover bg-paper shrink-0" onerror="this.style.display='none'" alt="" />
            <div class="min-w-0 flex-1"><div class="text-[13px] text-ink truncate">${escapeHtml(p.title)}</div><div class="text-[11px] text-mute">${formatVND(calculateFormulaVND(p.krw, p.weightClass, p.estKg).allInVND)}</div></div>
            <span class="text-[11px] text-soft shrink-0">Chọn →</span>
          </button>`).join('');
        box.classList.remove('hidden');
      }

      if (matches.length && matches[0].sc >= 7) {
        useLensMatch(matches[0].p.id, true);
        if (price && price !== matches[0].p.krw) fPrice.value = price;
      } else {
        if (sig) fBrand.value = sig.brand + ' (' + sig.mall + ')';
        if (price) fPrice.value = price;
        if (sig) fName.value = sig.brand + ' — ';
      }
      recalculateLensVND();

      if (!text.trim()) setLensStatus('Chưa đọc được chữ trên ảnh. Bạn điền tên và giá giúp shop, hoặc bấm “Nhờ shop báo giá”.');
      else if (!fName.value.replace(/[—\s]/g, '') || !fPrice.value) setLensStatus('Đã nhận diện một phần — bạn kiểm tra và điền nốt tên / giá nhé. Không rõ giá thì bấm “Nhờ shop báo giá”.');
      else setLensStatus('Đã nhận diện xong — bạn kiểm tra lại thông tin trước khi thêm vào giỏ.');

      if (overlay) { overlay.classList.add('hidden'); overlay.classList.remove('flex'); }
    }

    function useLensMatch(id, silent) {
      const p = currentProductsList.find(x => x.id === id);
