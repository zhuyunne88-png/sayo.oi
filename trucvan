      if (q.includes('tính giá') || q.includes('công thức') || q.includes('tỷ giá') || q.includes('tiền ship') || q.includes('công mua') || q.includes('giá về tay')) {
        return `${b('Công thức giá về tay tại sayo.oi:')}<br/>
${b('Giá về tay = (Giá web Hàn × 21) + Công mua + Cước cân (180k/kg)')}<br/>
- <em>Công mua:</em> 30k/món (&lt; 1kg) hoặc 60k/món (≥ 1kg).<br/>
- <em>Tỷ giá:</em> cố định 21 VND / 1 KRW.<br/>
- <em>Cước bay:</em> 180.000đ/kg tính trên tổng cân cả đơn, làm tròn lên nấc 0.5kg.`;
      }
      if (q.includes('theo dõi') || q.includes('tra cứu') || q.includes('đơn của') || q.includes('mã đơn')) {
        return `Bạn vào mục ${b('Theo dõi đơn hàng')} trên thanh menu, nhập mã ORD và số điện thoại để xem đơn đang ở chặng nào nhé!`;
      }
      if (contextItem) {
        return `Sản phẩm ${b(escapeHtml(contextItem.title))} thuộc thương hiệu ${b(escapeHtml(contextItem.brand))}.<br/>
- <em>Công dụng:</em> ${escapeHtml(contextItem.benefit || '')}<br/>
- <em>Phù hợp:</em> ${escapeHtml(contextItem.targetAudience || 'Mọi loại da / dáng người.')}`;
      }
      return `Cảm ơn câu hỏi của bạn! Bạn có thể hỏi mình về <em>“thời gian hàng về”</em>, <em>“quà biếu cho bố mẹ”</em>, <em>“cách tính giá”</em> hoặc nhắn Instagram ${b(SHOP.instagramHandle)} để gặp trực tiếp shop nhé!`;
    }

    // =======================================================
    // 6. HÀNH TRÌNH 5 CHẶNG
    // =======================================================
    let currentStage = 1;
    let autoPlayTimer = null;

    const boxSvg = (label, sub, tag) => `
      <div class="relative w-40 h-28 bg-[#f3e7df] border border-[#e2cfc3] flex flex-col items-center justify-center">
        <div class="absolute inset-x-0 top-1/2 h-px bg-[#e2cfc3]"></div>
        <div class="absolute inset-y-0 left-1/2 w-px bg-[#e2cfc3]"></div>
        <div class="relative bg-white px-3 py-1.5 text-center border border-[#eadbd2]">
          <div class="logo-word text-lg leading-none">${label}</div>
          <div class="text-[9px] tracking-[.18em] uppercase text-mute mt-0.5">${sub}</div>
        </div>
        ${tag ? `<span class="absolute -top-2.5 -right-2.5 bg-ink text-white text-[9px] tracking-[.14em] uppercase px-2 py-1">${tag}</span>` : ''}
      </div>`;

    function setJourneyStage(stage) {
      currentStage = stage;
      document.querySelectorAll('.journey-btn').forEach(btn => btn.classList.toggle('is-active', Number(btn.getAttribute('data-stage')) === stage));
      const titles = { 1: 'Chặng 01 / 05 · Gom hàng tại Busan', 2: 'Chặng 02 / 05 · Cân & đóng thùng', 3: 'Chặng 03 / 05 · Bay Busan → Hà Nội', 4: 'Chặng 04 / 05 · Thông quan Nội Bài', 5: 'Chặng 05 / 05 · Giao tận tay' };
      const badge = document.getElementById('stageBadge');
      if (badge) badge.textContent = titles[stage];
      const prog = document.getElementById('stageProgress');
      if (prog) prog.style.width = `${stage * 20}%`;
      const canvas = document.getElementById('sceneCanvas');
      if (!canvas) return;

      const caption = t => `<p class="text-[13px] text-soft mt-7 max-w-sm mx-auto leading-relaxed">${t}</p>`;
      let html = '';
      if (stage === 1) {
        html = `<div class="flex items-center justify-center gap-6">
            <div class="w-28 h-28 bg-blush-50 border border-blush-200 flex flex-col items-center justify-center text-center">
              <div class="font-serif italic text-2xl text-blush-700">web Hàn</div>
              <div class="text-[9px] tracking-[.16em] uppercase text-mute mt-1">Olive Young · KREAM</div>
            </div>
            <span class="font-serif text-3xl text-mute">→</span>
            ${boxSvg('sayo.oi', 'kho Busan', 'đã gom')}
          </div>${caption('Shop kiểm tra kỹ đúng mẫu, đúng loại mỹ phẩm và size thời trang trước khi đóng kiện.')}`;
      } else if (stage === 2) {
        html = `<div class="flex items-end justify-center gap-6">
            ${boxSvg('sayo.oi', 'niêm phong', '')}
            <div class="border border-ink bg-white px-5 py-4 text-left">
              <div class="text-[9px] tracking-[.18em] uppercase text-mute">Cân điện tử Busan</div>
              <div class="font-serif text-4xl text-ink leading-none mt-1">0.85<span class="text-lg"> kg</span></div>
              <div class="text-[11px] text-soft mt-1">Cước bay: 153.000 đ</div>
            </div>
          </div>${caption('Cân đo minh bạch từng gram tại kho Busan, quấn màng xốp chống sốc cẩn thận.')}`;
      } else if (stage === 3) {
        html = `<div class="float-soft flex flex-col items-center">
            <svg viewBox="0 0 340 120" class="w-64 sm:w-80">
              <path d="M10 95 Q 170 0 330 80" fill="none" stroke="#e8b4bd" stroke-width="1.2" stroke-dasharray="4 6"/>
              <g transform="translate(150 30) rotate(12)">
                <path d="M0 18 Q 6 10 24 10 L 70 10 Q 84 10 88 16 Q 84 22 70 22 L 14 22 Z" fill="#fff" stroke="#1c1a19" stroke-width="1.2"/>
                <path d="M6 17 L -4 2 L 8 2 L 18 12 Z" fill="#1c1a19"/>
                <path d="M34 16 L 22 36 L 36 36 L 52 16 Z" fill="#1c1a19"/>
              </g>
              <circle cx="10" cy="95" r="4" fill="#1c1a19"/><circle cx="330" cy="80" r="4" fill="#a35d6a"/>
              <text x="10" y="115" font-family="Cormorant Garamond, serif" font-size="14" fill="#5f5a57">Busan</text>
              <text x="330" y="102" text-anchor="end" font-family="Cormorant Garamond, serif" font-size="14" fill="#5f5a57">Hà Nội</text>
            </svg>
          </div>${caption('Chuyến bay thẳng Gimhae (Busan) → Nội Bài (Hà Nội), chỉ 3 – 5 ngày.')}`;
      } else if (stage === 4) {
        html = `<div class="flex items-center justify-center gap-6">
            ${boxSvg('Nội Bài', 'mã: ORD-001', '✓ thông quan')}
            <div class="text-left">
              <div class="text-[9px] tracking-[.18em] uppercase text-mute">Hải quan hàng không</div>
              <div class="font-serif text-2xl text-ink mt-1">Đã thông quan</div>
              <div class="text-[12px] text-soft">Phân luồng về kho Hà Nội</div>
            </div>
          </div>${caption('Hoàn tất thủ tục hải quan tại sân bay Nội Bài chỉ sau vài giờ hạ cánh.')}`;
      } else {
        html = `<div class="flex items-center justify-center gap-6">
            <svg viewBox="0 0 120 70" class="w-32"><rect x="4" y="14" width="70" height="38" fill="#fff" stroke="#1c1a19" stroke-width="1.2"/><path d="M74 26 H96 L112 40 V52 H74 Z" fill="#fff" stroke="#1c1a19" stroke-width="1.2"/><circle cx="26" cy="56" r="7" fill="#fff" stroke="#1c1a19" stroke-width="1.2"/><circle cx="94" cy="56" r="7" fill="#fff" stroke="#1c1a19" stroke-width="1.2"/><text x="39" y="38" text-anchor="middle" font-family="Cormorant Garamond, serif" font-style="italic" font-size="13" fill="#1c1a19">sayo.oi</text></svg>
            <div class="text-left">
              <div class="text-[9px] tracking-[.18em] uppercase text-mute">Giao hàng</div>
              <div class="font-serif text-2xl text-ink mt-1">Tận nơi toàn quốc</div>
              <div class="text-[12px] text-soft">Hỗ trợ kiểm tra hàng khi nhận</div>
