      canvas.innerHTML = `<div class="text-center w-full origin-center scale-[.78] sm:scale-100">${html}</div>`;
    }

    function toggleAutoJourney() {
      const btn = document.getElementById('autoPlayBtn');
      if (autoPlayTimer) { clearInterval(autoPlayTimer); autoPlayTimer = null; if (btn) btn.textContent = 'Tự động'; }
      else { startAutoJourney(); if (btn) btn.textContent = 'Tạm dừng'; }
    }
    function startAutoJourney() {
      if (autoPlayTimer) clearInterval(autoPlayTimer);
      autoPlayTimer = setInterval(() => { currentStage = currentStage >= 5 ? 1 : currentStage + 1; setJourneyStage(currentStage); }, 3500);
    }

    // =======================================================
    // 7. GIỎ HÀNG / FORM ĐẶT HÀNG
    // =======================================================
    function newBlankRow() { return { id: Date.now() + Math.floor(Math.random() * 1000), link: '', krw: 0, qty: 1, weightClass: 'under1', estKg: 0.35, variant: '', title: '', image: '' }; }
    function isRowFilled(r) { return !!((r.link && r.link.trim()) || (r.title && r.title.trim()) || (r.variant && r.variant.trim())); }

    let productRows = loadCart();

    function loadCart() {
      try {
        const saved = JSON.parse(localStorage.getItem(STORAGE_CART) || '[]');
        if (Array.isArray(saved) && saved.length) return saved;
      } catch (e) {}
      return [newBlankRow()];
    }
    function saveCart() {
      try { localStorage.setItem(STORAGE_CART, JSON.stringify(productRows)); } catch (e) {}
      updateCartBadge();
    }
    function updateCartBadge() {
      const n = productRows.filter(isRowFilled).reduce((s, r) => s + (Number(r.qty) || 0), 0);
      const b = document.getElementById('cartCountBadge');
      if (b) b.textContent = n;
    }

    function renderOrderRows() {
      const container = document.getElementById('productItemsContainer');
      if (!container) return;
      if (!productRows.length) productRows = [newBlankRow()];
      container.innerHTML = productRows.map((r, i) => {
        const lineVND = cleanKrw(r.krw) > 0 ? (cleanKrw(r.krw) * EXCHANGE_RATE + (r.weightClass === 'over1' ? FEE_OVER_1KG : FEE_UNDER_1KG)) * (Number(r.qty) || 1) : 0;
        const head = r.title
          ? `<div class="flex items-center gap-3 min-w-0">
               ${r.image ? `<img src="${escapeHtml(r.image)}" class="w-14 h-14 object-cover bg-paper shrink-0" onerror="this.style.display='none'" alt="" />` : ''}
               <div class="min-w-0"><div class="font-serif text-lg leading-snug text-ink line-clamp-2">${escapeHtml(r.title)}</div></div>
             </div>`
          : `<div class="font-serif text-lg text-ink">Sản phẩm ${String(i + 1).padStart(2, '0')}</div>`;
        return `
          <div class="py-6 space-y-4">
            <div class="flex justify-between items-start gap-4">
              ${head}
              <div class="text-right shrink-0">
                ${lineVND ? `<div class="price text-xl text-ink">${formatVND(lineVND)}</div><div class="text-[10px] text-mute">chưa gồm cước</div>` : `<div class="text-[12px] text-blush-700">${isRowFilled(r) ? 'Chờ shop báo giá' : 'Nhập giá KRW'}</div>`}
                <button type="button" onclick="removeProductRow(${r.id})" class="text-[11px] text-mute hover:text-blush-700 mt-1">Xóa</button>
              </div>
            </div>
            <div class="grid grid-cols-3 gap-4">
              <div>
                <label class="label">Giá KRW *</label>
                <input type="number" min="0" value="${r.krw || ''}" placeholder="Không rõ thì để trống" onchange="updateRow(${r.id}, 'krw', this.value)" class="field-box" />
              </div>
              <div>
                <label class="label">Số lượng *</label>
                <input type="number" min="1" value="${r.qty}" onchange="updateRow(${r.id}, 'qty', this.value)" class="field-box" />
              </div>
              <div>
                <label class="label">Công mua</label>
                <select onchange="updateRow(${r.id}, 'weightClass', this.value)" class="field-box">
                  <option value="under1" ${r.weightClass === 'under1' ? 'selected' : ''}>&lt; 1kg (+30k)</option>
                  <option value="over1" ${r.weightClass === 'over1' ? 'selected' : ''}>&ge; 1kg (+60k)</option>
                </select>
              </div>
            </div>
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="label">Link sản phẩm *</label>
                <input type="text" value="${escapeHtml(r.link)}" onchange="updateRow(${r.id}, 'link', this.value)" placeholder="Dán link web Hàn…" class="field-box" />
              </div>
              <div>
                <label class="label">Phân loại (loại / vị / mã màu) *</label>
                <input type="text" value="${escapeHtml(r.variant)}" onchange="updateRow(${r.id}, 'variant', this.value)" placeholder="VD: Vị Berry / Loại PDRN…" class="field-box" />
              </div>
            </div>
          </div>`;
      }).join('');
      recalculateOrderSummary();
      updateCartBadge();
    }

    function updateRow(id, field, val) {
      const r = productRows.find(x => x.id === id);
      if (!r) return;
      r[field] = (field === 'krw' || field === 'qty') ? Math.max(field === 'qty' ? 1 : 0, Number(val) || 0) : val;
      saveCart();
      renderOrderRows();
    }

    function addProductRow() {
      productRows.push(newBlankRow());
      saveCart();
      renderOrderRows();
    }

    function removeProductRow(id) {
      productRows = productRows.filter(r => r.id !== id);
      if (!productRows.length) productRows = [newBlankRow()];
      saveCart();
      renderOrderRows();
    }

    function pushRowToCart(row) {
      // Nếu giỏ chỉ có 1 dòng trống mặc định thì thay thế, ngược lại thêm mới
      if (productRows.length === 1 && !isRowFilled(productRows[0])) productRows[0] = row;
      else {
        const same = row.link && productRows.find(r => r.link === row.link && r.variant === row.variant);
        if (same) same.qty = (Number(same.qty) || 1) + 1; else productRows.push(row);
      }
      saveCart();
      renderOrderRows();
    }

    function productToRow(item) {
      return { id: Date.now() + Math.floor(Math.random() * 1000), link: item.link, krw: item.krw, qty: 1, weightClass: item.weightClass, estKg: item.estKg, variant: item.variant, title: item.title, image: item.image };
    }

    function addToCart(id) {
      const item = currentProductsList.find(p => p.id === id);
      if (!item) return;
      pushRowToCart(productToRow(item));
      showToast('Đã thêm vào giỏ hàng', true);
    }

    function orderProductItemDirect(id) {
      const item = currentProductsList.find(p => p.id === id);
      if (!item) return;
      pushRowToCart(productToRow(item));
      switchPageView('order');
    }

    function recalculateOrderSummary() {
      const t = calculateOrderTotals(productRows.filter(r => isRowFilled(r) || cleanKrw(r.krw) > 0));
      const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = formatVND(v); };
      set('summaryConvertedVND', t.converted); set('summaryFeeVND', t.fee); set('summaryShippingVND', t.ship); set('summaryGrandTotalVND', t.total);
      const kgEl = document.getElementById('summaryShipLabel');
      if (kgEl) kgEl.textContent = t.billedKg ? `Cước bay (${kgLabel(t.billedKg)} × 180k)` : 'Cước bay (180k/kg)';
      const pe = document.getElementById('summaryPendingNote');
      if (pe) { pe.classList.toggle('hidden', !t.pending); pe.textContent = t.pending ? `+ ${t.pending} món chờ shop báo giá (chưa tính vào tổng)` : ''; }
      return t;
    }

    async function handleOrderSubmit(e) {
      if (e && e.preventDefault) e.preventDefault();
      const filled = productRows.filter(r => isRowFilled(r) || cleanKrw(r.krw) > 0);
      if (!filled.length) { alert('Giỏ hàng đang trống, bạn thêm sản phẩm trước nhé!'); return; }
      if (!API_READY) { alert('Web chưa kết nối Google Sheets nên chưa nhận đơn được.\nBạn nhắn shop qua Instagram ' + SHOP.instagramHandle + ' nhé!'); return; }

      const btn = document.getElementById('submitOrderBtn');
      if (btn) { btn.disabled = true; btn.textContent = 'Đang gửi đơn…'; }

      const totals = recalculateOrderSummary();
      const items = filled.map(r => {
        const it = { link: r.link || '', krw: cleanKrw(r.krw), qty: Math.max(1, Number(r.qty) || 1), weightClass: r.weightClass, estKg: r.estKg, variant: r.variant || '', title: r.title || '' };
        if (r.image && String(r.image).startsWith('data:image/')) it.imageData = r.image; else if (r.image) it.image = r.image;
        return it;
      });
      const payload = {
        customerName: document.getElementById('customerName').value.trim(),
        customerPhone: document.getElementById('customerPhone').value.trim(),
        customerAddress: document.getElementById('customerAddress').value.trim(),
        items,
        grandTotalVND: totals.total
      };

      try {
        const result = await apiPost(payload);
        if (result.status === 'success' && result.orderId) {
          const orderId = result.orderId;
          const total = Number(result.total) || totals.total;
          const pendingTxt = result.pending ? `<p class="text-[12px] text-blush-700 pt-1">Có ${result.pending} món chờ báo giá — shop sẽ nhắn bạn giá chính xác.</p>` : '';
          document.getElementById('modalOrderCode').textContent = orderId;
          document.getElementById('modalSummaryText').innerHTML = `
            <div class="flex justify-between gap-4"><span class="text-mute">Khách</span><span class="text-ink text-right">${escapeHtml(payload.customerName)} · ${escapeHtml(payload.customerPhone)}</span></div>
            <div class="flex justify-between gap-4"><span class="text-mute">Nhận tại</span><span class="text-ink text-right">${escapeHtml(payload.customerAddress)}</span></div>
            <div class="flex justify-between gap-4"><span class="text-mute">Tạm tính</span><span class="price text-lg text-blush-700">${formatVND(total)}</span></div>
            ${pendingTxt}
            <p class="text-[11px] text-mute pt-2">Lưu lại mã đơn để tra cứu ở mục “Theo dõi đơn hàng”.</p>`;
          saveRecentOrder({ orderId, phone: payload.customerPhone, total: formatVND(total), count: items.reduce((s, r) => s + r.qty, 0), date: new Date().toISOString() });
          productRows = [newBlankRow()];
          saveCart();
          renderOrderRows();
          const m = document.getElementById('orderSuccessModal');
          m.classList.remove('hidden'); m.classList.add('flex');
        } else {
          alert('Chưa gửi được đơn: ' + (result.message || 'lỗi không rõ') + '\nBạn thử lại hoặc nhắn shop qua Instagram ' + SHOP.instagramHandle + ' nhé!');
        }
      } catch (err) {
        alert('Lỗi kết nối Google Sheets, bạn thử lại sau ít phút hoặc nhắn shop qua Instagram ' + SHOP.instagramHandle + ' nhé!');
      } finally {
        if (btn) { btn.disabled = false; btn.textContent = 'Gửi đơn & nhận mã ORD'; }
      }
    }

    function closeSuccessModal() {
      const m = document.getElementById('orderSuccessModal');
      m.classList.add('hidden'); m.classList.remove('flex');
    }

    // toast
    let toastTimer = null;
    function showToast(text, withCartLink) {
      const t = document.getElementById('toast');
      if (!t) return;
      document.getElementById('toastText').textContent = text;
      t.querySelector('button').style.display = withCartLink ? '' : 'none';
      t.classList.add('show');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(hideToast, 2600);
    }
    function hideToast() { const t = document.getElementById('toast'); if (t) t.classList.remove('show'); }

    // =======================================================
    // 8. THEO DÕI ĐƠN HÀNG
    // =======================================================
    const TRACK_STEPS = ['Đã nhận đơn', 'Đã mua tại Hàn', 'Cân & đóng thùng tại Busan', 'Đang bay về Việt Nam', 'Đã thông quan', 'Đang giao', 'Đã nhận hàng'];

    function getRecentOrders() { try { return JSON.parse(localStorage.getItem(STORAGE_ORDERS) || '[]'); } catch (e) { return []; } }
    function saveRecentOrder(o) {
      const list = getRecentOrders().filter(x => x.orderId !== o.orderId);
      list.unshift(o);
      try { localStorage.setItem(STORAGE_ORDERS, JSON.stringify(list.slice(0, 20))); } catch (e) {}
    }
    function renderRecentOrders() {
      const list = getRecentOrders();
      const box = document.getElementById('recentOrdersBox');
      const el = document.getElementById('recentOrdersList');
      if (!box || !el) return;
      box.classList.toggle('hidden', !list.length);
      el.innerHTML = list.map(o => `
        <button type="button" onclick="fillTrackForm('${escapeHtml(o.orderId)}', '${escapeHtml(o.phone)}')" class="w-full py-3.5 flex items-center justify-between text-left hover:bg-paper px-1 transition">
          <div>
            <div class="font-serif text-xl text-ink">${escapeHtml(o.orderId)}</div>
            <div class="text-[11px] text-mute">${new Date(o.date).toLocaleDateString('vi-VN')} · ${o.count || 1} sản phẩm</div>
          </div>
          <div class="text-right"><div class="price text-lg">${escapeHtml(o.total)}</div><div class="text-[11px] text-mute">Tra cứu →</div></div>
        </button>`).join('');
    }
    function fillTrackForm(code, phone) {
      document.getElementById('trackOrderCode').value = code;
      document.getElementById('trackPhone').value = phone;
      handleTrackOrder(new Event('submit'));
    }

    function renderTrackTimeline(order) {
      if (order.cancelled || order.status === 'Đã hủy') {
        return `<div class="card-surface p-6 sm:p-8 text-center">
          <div class="eyebrow">Mã đơn ${escapeHtml(order.orderId || '')}</div>
          <div class="font-serif text-3xl text-blush-700 mt-2">Đơn đã hủy</div>
          ${order.note ? `<p class="text-[13px] text-soft mt-3">${escapeHtml(order.note)}</p>` : ''}
        </div>`;
      }
      let idx = 0;
      if (typeof order.step === 'number') idx = order.step;
      else if (order.status) {
        const s = String(order.status).toLowerCase();
        const found = TRACK_STEPS.findIndex(x => x.toLowerCase() === s);
        idx = found >= 0 ? found : 0;
      }
      idx = Math.max(0, Math.min(TRACK_STEPS.length - 1, idx));
      return `
