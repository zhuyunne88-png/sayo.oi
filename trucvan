    async function syncProductsFromGoogleSheets() {
      // 1) hiển thị ngay dữ liệu đã lưu trên máy (nếu có)
      let hadCache = false;
      try {
        const saved = JSON.parse(localStorage.getItem(STORAGE_PRODUCTS) || '[]');
        if (Array.isArray(saved) && saved.length) { applyProducts(saved); hadCache = true; }
      } catch (e) {}

      // 2) tải bản mới nhất từ Google Sheets
      if (API_READY) {
        try {
          const res = await fetch(`${GOOGLE_SCRIPT_URL}?action=get_products`);
          const json = await res.json();
          const list = Array.isArray(json) ? json : (json && json.status === 'success' && Array.isArray(json.products) ? json.products : null);
          if (list) { applyProducts(list); saveProductsToStorage(); return; }
        } catch (e) { console.warn('Không tải được kho từ Google Sheets, dùng dữ liệu trên máy:', e); }
      }
      if (!hadCache) applyProducts([]);
    }

