        { r: /크림스킨/gi, v: 'Nước Hoa Hồng Dưỡng Ẩm Cream Skin' }, { r: /트리트먼트|헤어팩/gi, v: 'Ủ Tóc Phục Hồi' },
        { r: /선크림|선블록/gi, v: 'Kem Chống Nắng' }, { r: /수딩크림|수딩\s*크림/gi, v: 'Kem Dưỡng Dịu Da Soothing Cream' },
